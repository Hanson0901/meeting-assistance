# 忽略 Python 缓存和编译产物
../**/__pycache__/
*.py[cod]
*$py.class

# 忽略指定目录
outputs/
uploads/
offload/
*.gguf
# 忽略常见缓存目录
cache/

# Runtime/generated artifacts (avoid huge binary and noisy outputs)
output_audio.mkv
output_*.srt
output_*cache.json
output_meeting_summary.txt
output_actions.txt
finald_output_*.md
finalk_output_*.md
finalp_output_*.md
.cache/